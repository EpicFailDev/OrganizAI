# ============================================================
# OrganizAI - Backend API (apps/api)
# ============================================================
# Copie para .env e preencha. Estas variáveis também podem ser
# fornecidas pelo docker-compose (ver docker-compose.yml).
#
# ATENÇÃO: NUNCA commit o .env real. Mantenha este exemplo atualizado.

# Porta HTTP do servidor Hono (default 3000)
PORT=3000

# URL e chave ANON do Supabase (obrigatórias). A service role key NUNCA deve
# ser usada aqui — ela burlaria o RLS. Use apenas a chave anônima.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon

# (Opcional) Servidores divulgados na documentação OpenAPI
API_DOC_URL=https://doc.organizai.duckdns.org
API_URL=https://organizai.duckdns.org/api

# (Opcional) OAuth do servidor MCP
# URL pública do authorization server (issuer). Default: API_DOC_URL.
# MCP_OAUTH_ISSUER_URL=https://doc.organizai.duckdns.org
# E-mails autorizados no login do /authorize (separados por vírgula).
# Vazio = qualquer usuário válido do Supabase Auth.
MCP_OAUTH_ALLOWED_EMAILS=gui@organizai.local

# (Opcional) CORS e rate limit
# CORS_ORIGIN aceita uma lista separada por vírgula. O default é restrito às
# origens de desenvolvimento e aos domínios oficiais do OrganizAI.
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
